# Configuracoes do Banco de Dados para Hospedagem (InfinityFree / ByetHost)
DB_HOST=sql305.infinityfree.com
DB_PORT=3306
DB_USER=SEU_USUARIO_DO_PAINEL
DB_PASS=SUA_SENHA_DO_PAINEL
DB_NAME=SEU_BANCO_DO_PAINEL

# Chaves e Tokens
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI
# Gere um token forte, ex: php -r "echo bin2hex(random_bytes(32));"
INSTALL_TOKEN=GERE_UM_TOKEN_SECRETO_FORTE_AQUI
# Defina um código de convite secreto para criação de contas de professor
TEACHER_INVITE_CODE=DEFINA_UM_CODIGO_SECRETO_AQUI
