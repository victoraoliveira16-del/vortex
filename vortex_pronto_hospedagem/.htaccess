# MathPlay Solutions - Apache Configuration
DirectoryIndex index.php

# Proteger arquivos sensiveis
<FilesMatch "^\.(env|git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Charset padrao
AddDefaultCharset UTF-8
